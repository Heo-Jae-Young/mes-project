# Production Environment Variables
# Copy this file to .env.prod and fill in the actual values

# Django Backend Configuration
SECRET_KEY=your-super-secret-django-key-min-50-chars-long-for-production
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-ec2-ip-address
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Database Configuration (MariaDB)
DB_NAME=mes_production_db
DB_USER=mes_prod_user
DB_PASSWORD=your-very-secure-database-password
DB_ROOT_PASSWORD=your-very-secure-root-password

# React Frontend Configuration
REACT_APP_API_URL=https://your-domain.com/api

# AWS/EC2 Configuration (optional)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# SSL/TLS Configuration
SSL_EMAIL=your-email@domain.com
DOMAIN_NAME=your-domain.com

# Monitoring & Logging (optional)
SENTRY_DSN=your-sentry-dsn-url
LOG_LEVEL=INFO

# Security Configuration
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Backup Configuration (optional)
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
S3_BACKUP_BUCKET=your-backup-bucket